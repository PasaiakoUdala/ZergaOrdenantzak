<table id="taula" class="table bootstrap-table mt-3"
{{ stimulus_controller('table', { 
      'url': path('admin_user_index'),
		'exportName': 'users',
   }) }}
   data-page-number="{{ page }}" 
   data-page-size="{{ pageSize }}"
   data-page-sortName="{{ sortName }}"
   data-page-sortOrder="{{ sortOrder }}"
   
>
   <thead>
      <tr>
         <th data-sortable="true">{{"user.id" | trans({},'user_bundle') | capitalize}}</th>
         <th data-sortable="true">{{"user.username" | trans({},'user_bundle') | capitalize}}</th>
         <th data-sortable="true">{{"user.firstName" | trans({},'user_bundle') | capitalize}}</th>
         <th data-sortable="true">{{"user.email" | trans({},'user_bundle') | capitalize}}</th>
         <th data-sortable="true">{{"user.roles" | trans({},'user_bundle') | capitalize}}</th>
         <th data-sortable="true">{{"user.activated" | trans({},'user_bundle') | capitalize}}</th>
         <th data-sortable="true" data-field="options">{{"table.options" | trans({},'user_bundle') | capitalize}}</th>
      </tr>
   </thead>
   <tbody>
      {% for user in users %}
      <tr>
         <td>{{user.id}}</td>
         <td>{{user.username}}</td>
         <td>{{user.firstName}}</td>
         <td>{{user.email}}</td>
         <td>
                  {% set rolesCount = user.roles | filter((v,k) => v != 'ROLE_ADIERAZLEAK') | length %}
                  {% if rolesCount > 0 %}
                        {% for role in user.roles | filter((v,k) => v != 'ROLE_ADIERAZLEAK') %}
                           {{ role | trans({},'user_bundle') | capitalize }} 
                           {% if loop.index < rolesCount %}|{% endif %}
                        {% endfor %}
                  {% else %}
                        {{ 'ROLE_ADIERAZLEAK' | trans({},'user_bundle') }}
                  {% endif %}
         </td>
         <td>{{user.activated ? 'messages.si' | trans : 'messages.no' | trans}}</td>
         <td>
         <a href="{{ path ("admin_user_show",{'id': user.id })}}"
            data-return-url="{{ absolute_url(path(app.request.attributes.get('_route'))) }}" data-action="click->table#onClick" data-pagination="false"
            ><i class="fa fa-eye"></i></a>
         &nbsp;<a href="{{ path ("admin_user_edit",{'id': user.id })}}" 
            data-return-url="{{ absolute_url(path(app.request.attributes.get('_route'))) }}" data-action="click->table#onClick"  data-pagination="false"
            ><i class="fa fa-edit"></i></a>
         &nbsp;<a href="{{ path ('admin_user_delete',{'id': user.id })}}"
                  data-action="click->table#onClick" 
                  data-pagination="true"
                  data-return="false"
                  data-confirm="true"
                  >
                  <i class="fa fa-trash"></i>
               </a>
               {% if is_granted('ROLE_SUPER_ADMIN') %}
                  &nbsp;<a href="{{ path('admin_ordenantza_index', { _switch_user: user.username }) }}"><i class="glyphicon glyphicon-user" aria-hidden="true"></i></a>
               {% endif %}               
         </td>
      </tr>
      {% endfor %}
   </tbody>
</table>
